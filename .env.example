# =============================================================
# 環境変数サンプルファイル
# =============================================================
# このファイルをコピーして「.env」という名前で保存し、
# 実際のキーやパスワードを記入してください。
# .env ファイルは絶対にGitHubへ公開（コミット）しないでください。
# （.gitignoreに既に登録済みです）
# =============================================================

# --- Claude (Anthropic) API ---
# 取得方法: セットアップガイド「1. Claude APIキーの取得」を参照
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# CrewAI/LiteLLM が参照するモデル名（変更不要）
CREW_MODEL=anthropic/claude-sonnet-4-5-20250929

# --- 外部確認用プレビューページの公開先 (GitHub Pages) ---
# 取得方法: セットアップガイド「5. GitHub Pagesの有効化」を参照
# 例: https://your-username.github.io/your-repo-name
PREVIEW_BASE_URL=https://your-username.github.io/your-repo-name

# --- 通知メール送信用 (Gmail) ---
# 取得方法: セットアップガイド「4. Gmailアプリパスワードの取得」を参照
NOTIFY_SMTP_HOST=smtp.gmail.com
NOTIFY_SMTP_PORT=587
NOTIFY_SMTP_USER=your-gmail-address@gmail.com
NOTIFY_SMTP_APP_PASSWORD=xxxx xxxx xxxx xxxx
NOTIFY_FROM_NAME=SEO記事自動投稿システム

# =============================================================
# クライアントごとの認証情報
# config/clients.yaml の env_prefix に対応させてください
# =============================================================

# --- CLIENT_A（株式会社サンプル）---
# 取得方法: セットアップガイド「2. WordPressアプリケーションパスワードの取得」を参照
CLIENT_A_WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# 取得方法: セットアップガイド「3. Google Analytics / Search Console 連携」を参照
# サービスアカウントのJSON鍵ファイルのパス（このプロジェクト内に配置）
CLIENT_A_GOOGLE_SERVICE_ACCOUNT_JSON=config/secrets/client_a_google_service_account.json

# --- CLIENT_B（追加する場合はコピーして増やす）---
# CLIENT_B_WP_APP_PASSWORD=
# CLIENT_B_GOOGLE_SERVICE_ACCOUNT_JSON=config/secrets/client_b_google_service_account.json
